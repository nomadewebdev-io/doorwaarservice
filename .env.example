# ============================================================================
# CONFIGURATION SUPABASE
# ============================================================================
# URL de l'instance Supabase (accessible côté client et serveur, sans /rest/v1)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé anonyme publique (accessible côté client et serveur, JWT ou clé publishable sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-ou-publishable

# Clé secrète Service Role (ATTENTION : STRICTEMENT côté serveur, JAMAIS exposée au client ni préfixée par NEXT_PUBLIC_)
# Utilisée uniquement pour les opérations d'administration privilégiées et scripts de maintenance
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete

# ============================================================================
# CONTACT & NOTIFICATIONS
# ============================================================================
# Destinataire des notifications pour les demandes de visite et de contact (serveur)
CONTACT_EMAIL=kingzaf97@gmail.com
NEXT_PUBLIC_CONTACT_EMAIL=kingzaf97@gmail.com

# Identité publique DoorWaarSERVICE
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=221774898243
NEXT_PUBLIC_CONTACT_PHONE=+221 77 489 82 43
